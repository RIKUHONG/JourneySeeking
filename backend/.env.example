# Copy this file to .env and fill in MOMA_API_KEY locally.
AGENT_RUNTIME=legacy
# Empty selects v1 for legacy and p3-02-compat for langgraph.
PROMPT_GENERATION_VERSION=
PROMPT_STRUCTURED_REPAIR_VERSION=v1
PROMPT_CRITIC_REPAIR_VERSION=v1
PROMPT_DAY_EDIT_VERSION=v1
MOMA_API_URL=https://zhenze-huhehaote.cmecloud.cn/v1/chat/completions
MOMA_MODEL=deepseek-v4-flash-0731
MOMA_API_KEY=
MOMA_TIMEOUT_SECONDS=180
MOMA_MAX_RETRIES=1
MOMA_MAX_TOKENS=16384
# 0 derives the step limit from provider timeout and retry budgets.
ORCHESTRATION_STEP_TIMEOUT_SECONDS=0

# Amap resolves POIs, routes, and city coordinates for Open-Meteo forecasts.
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=10
AMAP_MAX_RETRIES=2

# Open-Meteo forecast data requires no API key for non-commercial use.
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_TIMEOUT_SECONDS=10
WEATHER_MAX_RETRIES=2
